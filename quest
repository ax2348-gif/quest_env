#!/system/bin/sh
# Invoke with `sh quest ...` on Android; also works with host sh for verification.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
verify() {
    [ -f "$ROOT/packages/$1/SHA256SUMS" ] || {
        echo "No built $1 package. Build/package it on the development computer first." >&2
        exit 1
    }
    (cd "$ROOT/packages/$1" && sha256sum -c SHA256SUMS)
}
case "${1:-help}" in
    pull)
        # Do not merge over edits or locally modified delivery artifacts.
        [ -z "$(git -C "$ROOT" status --porcelain)" ] || {
            echo "Working tree has local changes; commit or resolve them before pulling." >&2
            exit 1
        }
        git -C "$ROOT" pull --ff-only
        # Re-enter the updated script rather than executing the old copy's logic.
        exec sh "$ROOT/quest" _after-pull
        ;;
    _after-pull)
        verify telemetry
        sh "$ROOT/shell/install-profile.sh"
        echo "Updated. Telemetry has not been started. Use qr or sh quest run."
        ;;
    erid-key) exec sh "$ROOT/ssh/key.sh" ;;
    install-profile) exec sh "$ROOT/shell/install-profile.sh" ;;
    verify) verify "${2:-telemetry}" ;;
    run)
        verify telemetry
        exec quest-native run "$ROOT/packages/telemetry/libapp.so"
        ;;
    status) exec quest-native status ;;
    stop) exec quest-native stop ;;
    restart) exec quest-native restart ;;
    builtin) exec quest-native builtin ;;
    install-devtools)
        verify devtools
        expected="$(cd "$ROOT/packages/devtools" && sha256sum tools.tar.gz)"
        exec sh "$ROOT/packages/devtools/install.sh" \
            "$ROOT/packages/devtools/tools.tar.gz" "${expected%% *}"
        ;;
    *)
        echo "Usage: sh quest {pull|verify [telemetry|devtools]|run|status|stop|restart|builtin|install-devtools|install-profile|erid-key}"
        echo "pull updates files only; run verifies and restarts only the native XR app."
        ;;
esac
