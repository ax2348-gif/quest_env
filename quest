#!/system/bin/sh
# Invoke with `sh quest ...` on Android; also works with host sh for verification.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
verify() {
    [ -f "$ROOT/packages/$1/SHA256SUMS" ] || {
        echo "No built $1 package. Build/package it on the development computer first." >&2
        exit 1
    }
    (cd "$ROOT/packages/$1" && sha256sum -c SHA256SUMS)
}
launch() {
    operation="$1"
    shift
    viewer=yes
    for option in "$@"; do
        case "$option" in
            --no-viewer) viewer=no ;;
            *) echo "Unknown option: $option (use --no-viewer)" >&2; exit 2 ;;
        esac
    done
    # Noninteractive automation must not acquire a terminal or hang in curses.
    if [ ! -t 0 ] || [ ! -t 1 ]; then viewer=no; fi
    if [ "$viewer" = yes ]; then
        command -v python3 >/dev/null 2>&1 || {
            echo "Install Python: pkg install python; or use $operation --no-viewer" >&2
            exit 1
        }
        python3 -c 'import curses' || exit 1
    fi
    if [ "$operation" = run ]; then
        verify telemetry
        quest-native run "$ROOT/packages/telemetry/libapp.so"
    else
        quest-native "$operation"
    fi
    if [ "$viewer" = yes ]; then
        exec python3 "$ROOT/client/watch.py"
    fi
}
case "${1:-help}" in
    pull)
        # Do not merge over edits or locally modified delivery artifacts.
        [ -z "$(git -C "$ROOT" status --porcelain)" ] || {
            echo "Working tree has local changes; commit or resolve them before pulling." >&2
            exit 1
        }
        git -C "$ROOT" pull --ff-only
        # Re-enter the updated script rather than executing the old copy's logic.
        exec sh "$ROOT/quest" _after-pull
        ;;
    _after-pull)
        verify telemetry
        sh "$ROOT/shell/install-profile.sh"
        echo "Updated. Telemetry has not been started. Use qr or sh quest run."
        ;;
    watch)
        shift
        command -v python3 >/dev/null 2>&1 || {
            echo "Install Python in Termux first: pkg install python" >&2
            exit 1
        }
        exec python3 "$ROOT/client/watch.py" "$@"
        ;;
    erid-key) exec sh "$ROOT/ssh/key.sh" ;;
    install-profile) exec sh "$ROOT/shell/install-profile.sh" ;;
    verify) verify "${2:-telemetry}" ;;
    run|restart|builtin)
        operation="$1"
        shift
        launch "$operation" "$@"
        ;;
    status) exec quest-native status ;;
    stop) exec quest-native stop ;;
    install-devtools)
        verify devtools
        expected="$(cd "$ROOT/packages/devtools" && sha256sum tools.tar.gz)"
        exec sh "$ROOT/packages/devtools/install.sh" \
            "$ROOT/packages/devtools/tools.tar.gz" "${expected%% *}"
        ;;
    *)
        echo "Usage: sh quest {pull|watch [--host HOST --port PORT]|verify [telemetry|devtools]|run|status|stop|restart|builtin|install-devtools|install-profile|erid-key}"
        echo "run/restart/builtin show the viewer in this terminal; --no-viewer skips it."
        echo "pull updates files only; run loads the updated native library."
        ;;
esac
