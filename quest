#!/system/bin/sh
# Invoke with `sh quest ...` on Android; also works with host sh for verification.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
verify() {
    [ -f "$ROOT/packages/$1/SHA256SUMS" ] || {
        echo "No built $1 package. Build/package it on the development computer first." >&2
        exit 1
    }
    (cd "$ROOT/packages/$1" && sha256sum -c SHA256SUMS)
}
launch() {
    operation="$1"
    shift
    viewer=yes
    demo=off
    base_frame=live
    scheme=standard
    for option in "$@"; do
        case "$option" in
            --no-viewer) viewer=no ;;
            -s|--sim) demo=on ;;
            --scheme=body-frozen) scheme=body-frozen ;;
            --scheme=standard) scheme=standard ;;
            --base-frame=live) base_frame=live ;;
            --base-frame=frozen) base_frame=frozen ;;
            *) echo "Unknown option: $option (use -s, --scheme=standard|body-frozen, --base-frame=live|frozen, --no-viewer)" >&2; exit 2 ;;
        esac
    done
    if [ "$operation" = builtin ] && [ "$demo" = on ]; then
        echo "The bundled APK library has no demo; use q run -s." >&2; exit 2
    fi
    # Noninteractive automation must not acquire a terminal or hang in curses.
    if [ ! -t 0 ] || [ ! -t 1 ]; then viewer=no; fi
    if [ "$viewer" = yes ]; then
        command -v python3 >/dev/null 2>&1 || {
            echo "Install Python: pkg install python; or use $operation --no-viewer" >&2
            exit 1
        }
        python3 -c 'import curses' || exit 1
    fi
    if [ "$operation" = run ]; then verify telemetry; fi
    mkdir -p "$HOME/.config/quest-env"
    # Read once at native initialization. A plain launch explicitly disables it.
    if [ "$demo" = on ]; then demo_mode="$base_frame"; else demo_mode=off; fi
    if [ "$scheme" = body-frozen ]; then demo_mode="$demo_mode body-frozen"; fi
    (umask 077; printf '%s\n' "$demo_mode" > "$HOME/.config/quest-env/demo-mode.tmp")
    mv "$HOME/.config/quest-env/demo-mode.tmp" "$HOME/.config/quest-env/demo-mode"
    panel_request="$HOME/.config/quest-env/restore-terminal-once"
    rm -f "$panel_request"
    if [ "$viewer" = yes ]; then
        # Keep a supervising shell: terminal SIGINT reaches this process and
        # its child. A pending trap runs after the foreground child returns.
        trap 'interrupt_launch' INT
    fi
    if [ "$operation" = run ]; then
        quest-native run "$ROOT/packages/telemetry/libapp.so"
    else
        quest-native "$operation"
    fi
    if [ "$viewer" = yes ]; then
        # Request restoration only after the native launch completes. The XR
        # process consumes this file atomically, including across recreation.
        mkdir -p "$HOME/.config/quest-env"
        (umask 077; : > "$panel_request")
        viewer_result=0
        QUEST_VIEWER_OWNS_TELEMETRY=1 python3 "$ROOT/client/watch.py" || viewer_result=$?
        # Also handle SIGINT delivered only to the viewer, not the whole group.
        if [ "$viewer_result" -eq 130 ]; then interrupt_launch; fi
        trap - INT
        return "$viewer_result"
    fi
}
interrupt_launch() {
    # Ignore repeated Ctrl-C while the stop request is in flight.
    trap '' INT
    rm -f "$HOME/.config/quest-env/restore-terminal-once"
    echo "Stopping telemetry..."
    if ! quest-native stop; then
        echo "Telemetry stop failed; retry with q stop." >&2
    fi
    exit 130

}
case "${1:-help}" in
    pull)
        # Do not merge over edits or locally modified delivery artifacts.
        [ -z "$(git -C "$ROOT" status --porcelain)" ] || {
            echo "Working tree has local changes; commit or resolve them before pulling." >&2
            exit 1
        }
        git -C "$ROOT" pull --ff-only
        # Re-enter the updated script rather than executing the old copy's logic.
        exec sh "$ROOT/quest" _after-pull
        ;;
    _after-pull)
        verify telemetry
        sh "$ROOT/shell/install-profile.sh"
        echo "Updated. Telemetry has not been started. Use qr or sh quest run."
        ;;
    focus) exec python3 "$ROOT/client/watch.py" --focus ;;
    watch)
        shift
        command -v python3 >/dev/null 2>&1 || {
            echo "Install Python in Termux first: pkg install python" >&2
            exit 1
        }
        exec python3 "$ROOT/client/watch.py" "$@"
        ;;
    erid-key) exec sh "$ROOT/ssh/key.sh" ;;
    install-profile) exec sh "$ROOT/shell/install-profile.sh" ;;
    verify) verify "${2:-telemetry}" ;;
    run|restart|builtin)
        operation="$1"
        shift
        launch "$operation" "$@"
        ;;
    status) exec quest-native status ;;
    stop)
        rm -f "$HOME/.config/quest-env/restore-terminal-once"
        exec quest-native stop ;;
    install-devtools)
        verify devtools
        expected="$(cd "$ROOT/packages/devtools" && sha256sum tools.tar.gz)"
        exec sh "$ROOT/packages/devtools/install.sh" \
            "$ROOT/packages/devtools/tools.tar.gz" "${expected%% *}"
        ;;
    *)
        echo "Usage: sh quest {pull|watch [--host HOST --port PORT]|verify [telemetry|devtools]|run|status|stop|restart|builtin|install-devtools|install-profile|erid-key}"
        echo "run/restart/builtin show the viewer in this terminal; --no-viewer skips it."
        echo "run -s --scheme=body-frozen: independent clutch frames; left stick click toggles smooth automove."
        echo "run -s enables the local kinematics demo; --base-frame=frozen freezes clutch base frames."
        echo "pull updates files only; run loads the updated native library."
        ;;
esac
